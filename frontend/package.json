{
  "name": "signal-room-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --mode private",
    "generate:demo": "python -m signal_room.cli export-demo",
    "audit": "node scripts/audit-gate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build:private": "tsc --noEmit && vite build --mode private",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/check-demo-privacy.mjs",
    "build": "npm run build:private && npm run build:demo",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4173",
    "capture:demo": "node scripts/capture-demo.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@xyflow/react": "12.11.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
