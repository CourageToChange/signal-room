# Local development defaults. Production refuses development auth.
SIGNAL_ROOM_ENVIRONMENT=development
SIGNAL_ROOM_RUNTIME_ROLE=all
SIGNAL_ROOM_MODE=fixture
SIGNAL_ROOM_AUTH_MODE=development
SIGNAL_ROOM_CONFIG_PATH=config/config.example.yaml
SIGNAL_ROOM_RUNBOOKS_PATH=config/runbooks.yaml
SIGNAL_ROOM_DB_PATH=data/signal-room.sqlite3
SIGNAL_ROOM_QUERY_SOCKET=run/query.sock
SIGNAL_ROOM_INGEST_SOCKET=run/ingest.sock
SIGNAL_ROOM_NOTIFIER_SOCKET=run/notifier.sock
SIGNAL_ROOM_MAINTENANCE_SOCKET=run/maintenance.sock
SIGNAL_ROOM_PUBLIC_ORIGIN=http://127.0.0.1:8080
SIGNAL_ROOM_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
SIGNAL_ROOM_LOG_LEVEL=INFO
SIGNAL_ROOM_BUILD_SHA=local-fixture

# Required only for the private Cloudflare Access deployment.
SIGNAL_ROOM_ACCESS_TEAM_DOMAIN=
SIGNAL_ROOM_ACCESS_AUDIENCE=
SIGNAL_ROOM_ALLOWED_EMAILS=

# Required only by the collector in live mode. Never expose these to the web service.
SIGNAL_ROOM_PVE_BASE_URL=
SIGNAL_ROOM_PVE_TOKEN_ID=
SIGNAL_ROOM_PVE_TOKEN_SECRET=
SIGNAL_ROOM_PVE_CA_BUNDLE=

# Optional signed notification receivers. Leave disabled by keeping every value empty.
SIGNAL_ROOM_WEBHOOK_URL=
SIGNAL_ROOM_WEBHOOK_SECRET=
SIGNAL_ROOM_DEADMAN_URL=
