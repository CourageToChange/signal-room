[Unit]
Description=Signal Room signed webhook notifier
After=signal-room-core.service network-online.target
Requires=signal-room-core.service
Wants=network-online.target
PartOf=signal-room.target

[Service]
Type=simple
User=signal-room-notifier
Group=signal-room-notifier
SupplementaryGroups=signal-room signal-room-notify
WorkingDirectory=/opt/signal-room/current
EnvironmentFile=/etc/signal-room/notifier.env
EnvironmentFile=/opt/signal-room/current/RELEASE_ENV
Environment=SIGNAL_ROOM_RUNTIME_ROLE=notifier
ExecStart=/opt/signal-room/current/.venv/bin/signal-room notify
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
MemoryHigh=80M
MemoryMax=96M
TasksMax=48

[Install]
WantedBy=signal-room.target
