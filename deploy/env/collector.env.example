SIGNAL_ROOM_ENVIRONMENT=production
SIGNAL_ROOM_MODE=live
SIGNAL_ROOM_CONFIG_PATH=/etc/signal-room/config.yaml
SIGNAL_ROOM_RUNBOOKS_PATH=/etc/signal-room/runbooks.yaml
SIGNAL_ROOM_INGEST_SOCKET=/run/signal-room/ingest.sock
SIGNAL_ROOM_PUBLIC_ORIGIN=https://signal.noorfamily.uk
SIGNAL_ROOM_TRUSTED_HOSTS=signal.noorfamily.uk
SIGNAL_ROOM_PVE_BASE_URL=https://REPLACE_WITH_PVE_API_HOST:8006
SIGNAL_ROOM_PVE_TOKEN_ID=REPLACE_WITH_PRIVILEGE_SEPARATED_TOKEN_ID
SIGNAL_ROOM_PVE_TOKEN_SECRET=REPLACE_WITH_PRIVILEGE_SEPARATED_TOKEN_SECRET
SIGNAL_ROOM_PVE_CA_BUNDLE=/etc/signal-room/pve-root-ca.pem
