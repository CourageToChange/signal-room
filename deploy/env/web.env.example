SIGNAL_ROOM_ENVIRONMENT=production
SIGNAL_ROOM_MODE=live
SIGNAL_ROOM_CONFIG_PATH=/etc/signal-room/config.yaml
SIGNAL_ROOM_RUNBOOKS_PATH=/etc/signal-room/runbooks.yaml
SIGNAL_ROOM_QUERY_SOCKET=/run/signal-room/query.sock
SIGNAL_ROOM_STATIC_DIR=/opt/signal-room/current/web
SIGNAL_ROOM_PUBLIC_ORIGIN=https://signal.noorfamily.uk
SIGNAL_ROOM_TRUSTED_HOSTS=signal.noorfamily.uk
SIGNAL_ROOM_AUTH_MODE=access
SIGNAL_ROOM_ACCESS_TEAM_DOMAIN=https://REPLACE_TEAM.cloudflareaccess.com
SIGNAL_ROOM_ACCESS_AUDIENCE=REPLACE_WITH_EXACT_ACCESS_AUD
SIGNAL_ROOM_ALLOWED_EMAILS=REPLACE_WITH_EXACT_ALLOWED_EMAIL
